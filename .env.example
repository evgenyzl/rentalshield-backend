# Copy this file to .env and fill in your values
# Never commit .env to git

# ── AI Provider ───────────────────────────────────────────────
# "gemini" = FREE (default)  |  "claude" = paid Anthropic
RENTALSHIELD_AI_PROVIDER=gemini

# ── Gemini (FREE) ─────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ── Claude (paid, ~$0.80 per scan) ───────────────────────────
# Only needed if RENTALSHIELD_AI_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...

# ── Optional tuning ────────────────────────────────────────────
# RENTALSHIELD_FRAME_INTERVAL_S=3
# RENTALSHIELD_GEMINI_MODEL=gemini-1.5-flash
# RENTALSHIELD_CLAUDE_MODEL=claude-opus-4-5
# RENTALSHIELD_LOG_LEVEL=INFO
